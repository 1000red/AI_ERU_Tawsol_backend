# ── App ──────────────────────────────────────────────
APP_NAME=ERU Tawasol
DEBUG=False

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eru_tawasol

# ── JWT ──────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-long-random-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=5

# ── OTP ──────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ── SendGrid (Email / OTP) ────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
# Leave empty to use console print in dev mode
SENDGRID_API_KEY=
FROM_EMAIL=noreply@eru-tawasol.com

# ── Firebase (Push Notifications) ────────────────────
# Download serviceAccountKey.json from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# ── S3 / MinIO (File Uploads) ────────────────────────
# Local MinIO (run: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001")
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=eru-tawasol
S3_PUBLIC_BASE_URL=http://localhost:9000/eru-tawasol

