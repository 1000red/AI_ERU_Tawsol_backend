{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/quarantine-purge",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__orig_path=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "maxDuration": 60
    }
  }
}
